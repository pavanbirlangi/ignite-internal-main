{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "increddy-storefront",
  "main": "custom-worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Lets the worker call itself (OpenNext uses it for revalidation).
      "binding": "WORKER_SELF_REFERENCE",
      "service": "increddy-storefront"
    }
  ],
  "kv_namespaces": [
    {
      // Next's data cache (unstable_cache, ISR pages).
      "binding": "NEXT_INC_CACHE_KV",
      "id": "bf82d88d070643c48dc0ab9e02b58aa8"
    },
    {
      // Rendered pages for signed-out visitors and resized images (custom-worker.js): global,
      // unlike the per-data-centre Cache API, so something made once is a hit from any location.
      "binding": "PAGE_CACHE_KV",
      "id": "f6f7cbe5b5d340f1a24794c75100e8ad"
    }
  ],
  // No placement setting: the worker runs in the data centre nearest each visitor. Pages are served
  // from the KV page cache there; only cache misses and background refreshes call the backend in
  // Mumbai. (Pinning the worker to Mumbai made every cache hit travel there first: 0.6-2 s.)
  // The deployed version's id: part of the page-cache key (custom-worker.js), so a new deploy never
  // serves pages that point at the previous build's script files.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  // Cloudflare Images: resizes /_next/image requests (without it the originals are sent).
  "images": {
    "binding": "IMAGES"
  },
  // Keep the *.workers.dev test address alongside the live domains.
  "workers_dev": true,
  // The live site. Cloudflare creates the DNS records for these names.
  "routes": [
    { "pattern": "www.increddy.com", "custom_domain": true },
    { "pattern": "increddy.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
