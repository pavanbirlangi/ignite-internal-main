{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "increddy-storefront",
  "main": "custom-worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Lets the worker call itself (OpenNext uses it for revalidation).
      "binding": "WORKER_SELF_REFERENCE",
      "service": "increddy-storefront"
    }
  ],
  "kv_namespaces": [
    {
      // Next's data cache (unstable_cache, ISR pages).
      "binding": "NEXT_INC_CACHE_KV",
      "id": "bf82d88d070643c48dc0ab9e02b58aa8"
    }
  ],
  // Run the worker next to the backend (api.increddy.com, AWS Mumbai): a page makes several backend
  // calls, so a far-away visitor pays one long hop instead of one per call. Smart placement never
  // engaged (US pages took 1-1.8 s of server time).
  "placement": {
    "region": "aws:ap-south-1"
  },
  // The deployed version's id: part of the page-cache key (custom-worker.js), so a new deploy never
  // serves pages that point at the previous build's script files.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  // Cloudflare Images: resizes /_next/image requests (without it the originals are sent).
  "images": {
    "binding": "IMAGES"
  },
  // Keep the *.workers.dev test address alongside the live domains.
  "workers_dev": true,
  // The live site. Cloudflare creates the DNS records for these names.
  "routes": [
    { "pattern": "www.increddy.com", "custom_domain": true },
    { "pattern": "increddy.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
